#!/usr/bin/env bash
# The `agentltl` command: install, validate, check, tools, trace, library, use, memory...
# Runs the guard's code from this plugin directory with the plugin's virtualenv, building it
# first if this version's dependency pins have none yet (see scripts/env.sh).
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PYTHONUTF8=1   # Windows pipes use the ANSI code page: the hook payload, rule files
                      # and the status line are UTF-8
# The environment is the plugin's own: a PYTHONPATH or PYTHONHOME the user's shell exports (a
# project's virtualenv, say) would put that project's packages ahead of ours. Tests and
# development point AGENTLTL_CODEX_PYTHON at their own Python and keep theirs.
if [[ -z "${AGENTLTL_CODEX_PYTHON:-}" ]]; then unset PYTHONPATH; fi
unset PYTHONHOME PYTHONEXECUTABLE VIRTUAL_ENV
# shellcheck source=../scripts/env.sh
source "$root/scripts/env.sh"
if [[ "${1:-}" == "doctor" ]]; then
    # In bash, not Python: it has to work when the environment does not.
    env_doctor
    exit $?
fi
py="$(env_python)"
[[ -n "$py" ]] || { env_build && py="$(env_python)"; }
if [[ -z "$py" ]]; then
    echo "agentltl: the guard is not installed; run $root/scripts/setup.sh" >&2
    exit 1
fi
exec "$py" -I -s "$root/scripts/launch.py" agentltl_codex.cli "$@"
