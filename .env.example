# Copy to .env (gitignored). Used only by docker/ to try the plugin on your own model.
# docker --env-file takes each line as is: no quotes, no comments after a value.
#
# An OpenAI-compatible server that serves the Responses API (/v1/responses; vLLM does), since
# Codex speaks nothing else (/v1 is added if missing), and its key (empty for none):
VLLM_BASE_URL=http://host:8000/v1
VLLM_API_KEY=
# The served model name (GET /v1/models):
VLLM_MODEL=qwen3.8-27b
